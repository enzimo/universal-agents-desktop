    "python",
    "-c",
    "import sys\nfrom custom_agents.openai_codex_auth import import_shared_codex_auth\ntry:\n    import_shared_codex_auth(codex_home=sys.argv[1], target_auth_store_path=sys.argv[2])\nexcept Exception:\n    print(\"UA could not import Codex credentials. Choose a current file-backed Codex auth.json and retry.\", file=sys.stderr)\n    sys.exit(1)\n"
