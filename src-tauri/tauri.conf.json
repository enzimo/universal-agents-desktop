{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Universal Agents",
  "version": "0.6.1",
  "identifier": "com.universalagents.desktop",
  "build": {
    "frontendDist": "../ui/desktop-shell"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "control",
        "title": "Universal Agents Launcher",
        "url": "index.html",
        "width": 1180,
        "height": 900,
        "minWidth": 820,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "backgroundColor": "#070b0e"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "Entitlements.plist",
      "minimumSystemVersion": "12.0"
    }
  }
}
